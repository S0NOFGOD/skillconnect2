generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model Contact {
  id        String   @id @default(cuid())
  email     String   @unique
  message   String
  createdAt DateTime @default(now())
}

model Worker {
  id                           String    @id @default(cuid())
  email                        String    @unique
  passwordHash                 String?
  googleId                     String?   @unique
  accountType                  String    @default("password")
  emailVerified                Boolean   @default(false)
  profileCompleted             Boolean   @default(false)

  fullName                     String?
  phone                        String?
  latitude                     Float?
  longitude                    Float?
  profilePhoto                 String?

  emailOtpHash                 String?
  emailOtpExpires              DateTime?
  emailOtpResendCount          Int       @default(0)
  emailOtpCooldownUntil        DateTime?

  passwordResetOtpHash         String?
  passwordResetOtpExpires      DateTime?
  passwordResetOtpResendCount  Int       @default(0)
  passwordResetOtpCooldownUntil DateTime?
  passwordResetOtpVerified     Boolean   @default(false)
  resetAuthorizationExpires    DateTime?

  refreshTokenHash             String?

  services                     Service[]
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
}

model Service {
  id            String   @id @default(cuid())
  workerId      String
  skill         String
  adminApproval String   @default("pending")
  worker        Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workerId])
  @@index([adminApproval])
}